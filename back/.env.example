CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (Neon): postgres://user:pass@ep-....neon.tech/neondb?sslmode=require
# DATABASE_URL=
AUTH_USERNAME=alifaghihi123
AUTH_PASSWORD=AliFaghihi@123
SESSION_SECRET=change-me-to-a-long-random-string
OCR_MAX_IMAGE_SIDE=1024
OCR_FAST=1
OCR_FAST_MAX_SIDE=1024
OCR_JPEG_QUALITY=78
CURSOR_OCR_RETRIES=0
HOST=0.0.0.0
PORT=8000

# Cursor Agent OCR — login via `cursor-agent login` or set key
OCR_USE_CURSOR=1
CURSOR_OCR_MODEL=composer-2.5
# Optional faster model for uploads when OCR_FAST=1 (e.g. composer-2-fast)
# CURSOR_OCR_FAST_MODEL=composer-2-fast
CURSOR_OCR_TIMEOUT=420
# Optional SQLite path for saved handwriting profiles (default: back/.data/handwriting.db)
# HANDWRITING_DB_PATH=
# CURSOR_API_KEY=crsr_...