{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "go",
  "buildCommand": "bash scripts/prepare-cursor-agent-bundle.sh && go build -ldflags '-s -w' -o server ./cmd/server",
  "build": {
    "env": {
      "PATH": "/var/task/.local/bin:/vercel/path0/.local/bin:/usr/local/bin:/usr/bin:/bin"
    }
  },
  "includeFiles": "cursor-agent-bundle.tgz",
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "0 4 * * *"
    }
  ]
}